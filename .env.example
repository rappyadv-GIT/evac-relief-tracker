# PostgreSQL connection string (Neon, Supabase, or your own server)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: set a password to require login (browser login prompt). Leave blank to disable.
APP_USERNAME=admin
APP_PASSWORD=

# Set to false only if your database does not support SSL (e.g. local PostgreSQL)
# DATABASE_SSL=false
# PORT=3000
